<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Version>2026.8.22</Version>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    </PropertyGroup>

    <!-- Release publish settings for smaller build size -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <PublishSingleFile>true</PublishSingleFile>
        <SelfContained>true</SelfContained>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
        <PublishTrimmed>true</PublishTrimmed>
        <TrimMode>partial</TrimMode>
        <!-- Nine IL2026s remain, all understood: three from EF Core's DbContext, six from
             the deliberate reflection fallback in Utils/Json. See TrimmerRootAssembly. -->
        <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
        <!-- IL2037: EF Core 10 DynamicDependency on ExecuteUpdate overload not resolvable by ILLink -->
        <NoWarn>$(NoWarn);IL2037</NoWarn>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='SteamRelease|AnyCPU'">
        <DefineConstants>STEAMRELEASE</DefineConstants>
        <PublishSingleFile>true</PublishSingleFile>
        <SelfContained>true</SelfContained>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
        <PublishTrimmed>true</PublishTrimmed>
        <TrimMode>partial</TrimMode>
        <!-- Nine IL2026s remain, all understood: three from EF Core's DbContext, six from
             the deliberate reflection fallback in Utils/Json. See TrimmerRootAssembly. -->
        <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
        <!-- IL2037: EF Core 10 DynamicDependency on ExecuteUpdate overload not resolvable by ILLink -->
        <NoWarn>$(NoWarn);IL2037</NoWarn>
    </PropertyGroup>

    <ItemGroup Condition="'$(Configuration)' == 'SteamRelease'">
        <PackageReference Include="Steamworks.NET.AnyCPU" Version="2026.163.0-a" />
    </ItemGroup>

    <!--
      Keep our own assembly out of the trimmer entirely.

      Two things still reach members reflectively in a way the trimmer cannot follow:
      EF Core over the entity types, and the DefaultJsonTypeInfoResolver fallback in
      Utils/Json (a safety net for any type not registered in AppJsonContext). If the
      trimmer removed a member only those reach, config would silently fail to load or the
      database would misbehave — in Release builds only, since Debug never trims, so it
      would not reproduce during development.

      Config serialisation itself is source-generated now and no longer needs this; moving
      off Newtonsoft took the count from 33 IL2026 warnings to 9. Rooting the assembly costs
      little (it is small next to the framework) and leaves PublishTrimmed doing what it is
      actually there for, which is trimming the framework and the UI stack.
    -->
    <ItemGroup Condition="'$(Configuration)' == 'Release' Or '$(Configuration)' == 'SteamRelease'">
        <TrimmerRootAssembly Include="VRCVideoCacher" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.0.3" />
        <PackageReference Include="Avalonia.Desktop" Version="12.0.3" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.3" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.3" />
        <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.0.0" />
        <!-- Have this here to resolve vulnerability warning -->
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
        <PackageReference Include="AsyncImageLoader.Avalonia" Version="3.8.0" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.8" />
        <!-- Override vulnerable transitive SQLitePCLRaw (NU1903, GHSA-2m69-gcr7-jv3q) -->
        <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
        <PackageReference Include="EmbedIO" Version="3.5.2" />
        <PackageReference Include="securifybv.ShellLink" Version="0.1.0" />
        <PackageReference Include="Semver" Version="3.0.0" />
        <PackageReference Include="Serilog" Version="4.3.1" />
        <PackageReference Include="Serilog.Expressions" Version="5.0.0" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
        <PackageReference Include="SharpCompress" Version="0.48.1" />
        <PackageReference Include="ValveKeyValue" Version="0.20.0.417" />
        <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
        <!-- Avalonia.Diagnostics has no 12.x release on NuGet (re-checked 2026-08-22: latest
             published is 11.3.20), so the Debug-only DevTools inspector stays unavailable. -->
        <!-- <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="Avalonia.Diagnostics" Version="12.0.3" /> -->
        <PackageReference Include="Jeek.Avalonia.Localization" Version="12.0.2" />
        <!-- Pin transitive dependency to fix GHSA-xrw6-gwf8-vvr9 (high severity) -->
        <PackageReference Include="Tmds.DBus.Protocol" Version="0.92.0" />
        <PackageReference Include="Vanara.PInvoke.IpHlpApi" Version="5.0.7" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="VRCVideoCacher.Tests" />
    </ItemGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\icon.ico" />
        <AvaloniaResource Include="Assets\SmallBanner.png" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="yt-dlp-stub.exe" />
        <EmbeddedResource Include="yt-dlp-stub.exe">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </EmbeddedResource>
        <None Update="OpenVR\openvr_api.dll">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
          <TargetPath>openvr_api.dll</TargetPath>
        </None>
        <None Update="OpenVR\libopenvr_api.so">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
          <TargetPath>libopenvr_api.so</TargetPath>
        </None>
        <EmbeddedResource Include="manifest.vrmanifest" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="Languages\*.loc.json" />
        <EmbeddedResource Include="Languages\*.loc.json" />
    </ItemGroup>

</Project>
